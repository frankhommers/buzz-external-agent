{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["**", "!dist", "!node_modules", "!.superpowers", "!docs", "!**/*.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/ui/**"],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    }
  ]
}
